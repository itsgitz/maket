# Copy to .env for local development (`bun run dev` loads it).
# Hosts include the port when it isn't the scheme's default.

MAKET_LISTEN_ADDR=:8080

# Production: app.kotakserver.my.id
MAKET_APP_HOST=app.localhost:5173

# Production: cloudshare.my.id (previews at <slug>.<this>)
MAKET_PREVIEW_DOMAIN=preview.localhost:8080

# Production: https
MAKET_PUBLIC_SCHEME=http
