# Copy to .env for local development (`bun run dev` loads it).
# Hosts include the port when it isn't the scheme's default.

MAKET_LISTEN_ADDR=:8080

# Production: app.kotakserver.my.id
MAKET_APP_HOST=app.localhost:5173

# Production: cloudshare.my.id (previews at <slug>.<this>)
MAKET_PREVIEW_DOMAIN=preview.localhost:8080

# Production: https
MAKET_PUBLIC_SCHEME=http

# Production: /data (the container volume). Holds maket.db and storage/.
# Relative paths resolve from apps/api, where `bun run dev` starts Go.
MAKET_DATA_DIR=./data

# Prototype file storage: "local" (MAKET_DATA_DIR/storage) or "s3".
MAKET_STORAGE_DRIVER=local

# With MAKET_STORAGE_DRIVER=s3, set these. Cloudflare R2 uses region "auto"
# (the default) and endpoint https://<account-id>.r2.cloudflarestorage.com.
# MinIO works with its own http or https URL.
# MAKET_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MAKET_S3_BUCKET=maket-prototypes
# MAKET_S3_REGION=auto
# MAKET_S3_ACCESS_KEY_ID=replace-me
# MAKET_S3_SECRET_ACCESS_KEY=replace-me

# GitHub OAuth app. For development, create one with callback URL
# http://app.localhost:5173/api/auth/github/callback
# (production: https://app.kotakserver.my.id/api/auth/github/callback).
MAKET_GITHUB_CLIENT_ID=replace-me
MAKET_GITHUB_CLIENT_SECRET=replace-me

# Comma-separated GitHub usernames allowed to sign in (case-insensitive).
MAKET_ALLOWED_GITHUB_USERS=itsgitz

# Upload limits.
MAKET_MAX_UPLOAD_MB=20
MAKET_MAX_EXTRACTED_MB=100
MAKET_MAX_FILES=500
MAKET_USER_QUOTA_MB=1024

# Optional Cloudflare cache purge after re-upload/delete (set both or neither).
MAKET_CF_API_TOKEN=
MAKET_CF_ZONE_ID=
